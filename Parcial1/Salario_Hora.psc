Algoritmo Salario_Hora
	
	Definir SalarioH, Resultado Como Real
	Definir HorasT Como Entero
	
	Escribir "Ingrese su salario por hora: "
	Leer SalarioH
	
	Escribir "Ingrese sus horas trabajadas: "
	Leer HorasT
	
	Resultado <- SalarioH * HorasT
	
	Escribir "Su sueldo por las horas trabajadas es de: $", Resultado
	
FinAlgoritmo
